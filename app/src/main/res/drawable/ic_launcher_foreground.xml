<?xml version="1.0" encoding="utf-8"?>
<!--
  Able Pulse mark (BRAND-001): a lowercase "a" made of a ring and a stem whose lower segment is
  a mint level indicator. Concept geometry scaled by 0.9 around the 108-unit centre so the whole
  mark stays inside the 66dp safe zone (farthest point about 29 units from the centre).
  Drago Labs IP, not covered by the GPL (ADR-011).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ring: centre (52.65, 54), radius 15.3, stroke 9. -->
    <path
        android:pathData="M37.35,54a15.3,15.3 0,1 0,30.6 0a15.3,15.3 0,1 0,-30.6 0"
        android:strokeWidth="9"
        android:strokeColor="#FFFFFFFF" />
    <!-- Stem: x 66.15..75.15, y 34.2..70.2, corner 4.5. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M66.15,38.7a4.5,4.5 0,0 1,9 0v27a4.5,4.5 0,0 1,-9 0z" />
    <!-- Level segment: y 54..70.2. -->
    <path
        android:fillColor="#FF3DF2B0"
        android:pathData="M66.15,58.5a4.5,4.5 0,0 1,9 0v7.2a4.5,4.5 0,0 1,-9 0z" />
</vector>
