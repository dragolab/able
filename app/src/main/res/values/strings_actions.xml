    <!-- Access needed by privileged actions (ADR-023) -->
    <string name="action_privilege_secure">Needs ADB or Shizuku</string>
    <string name="action_privilege_secure_help">This action changes a protected system setting. After granting \"Write secure settings\" through ADB, or with Shizuku connected (Able then grants itself that permission once and tells you), it runs directly from the tile or widget. Without that access it opens the matching Android settings screen instead. Able reads the setting back and tells you if Android did not apply it.</string>
    <string name="action_privilege_write_settings">Needs “Modify system settings”</string>
    <string name="action_privilege_write_settings_help">Android asks you to allow Able to modify system settings. Until you allow it, the tile or widget opens that permission screen. You can revoke the permission at any time in Android settings.</string>
    <string name="action_privilege_accessibility">Needs the Able screen lock service</string>
    <string name="action_privilege_accessibility_help">Locking uses the optional Able screen lock service, which does not read screen content. Until you enable it, the tile or widget opens the screen lock setup.</string>
    <string name="action_privilege_notification_policy">Silent needs Do Not Disturb access</string>
    <string name="action_privilege_notification_policy_help">Sound and Vibrate work without extra access. Switching to Silent, or leaving it while Do Not Disturb is on, needs Do Not Disturb access; without it the cycle skips Silent and Android may reject the change.</string>

    <!-- Tiles and widgets configuration (CUST-001, CUST-002) -->
    <string name="tiles_screen_title">Tiles &amp; widgets</string>
    <string name="tiles_screen_intro">Assign Able actions to Quick Settings tiles and home-screen widgets. Actions that need extra access open the right screen until access is granted.</string>
    <string name="tiles_help_title">How tiles and widgets work</string>
    <string name="tiles_help_text">Custom tile slots and the custom widget run the action you assign and show its real state, read back from Android. If an action needs access Able does not have, the tile or widget opens the screen where you can grant it or change the setting yourself. Nothing runs automatically.</string>
