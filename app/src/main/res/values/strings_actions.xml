    <string name="action_nfc_title">NFC</string>
    <string name="action_nfc_desc">Turns NFC on or off directly when \"Write secure settings\" is granted (through ADB, or by Able itself through Shizuku); otherwise opens the NFC settings.</string>
    <string name="action_auto_brightness_title">Auto brightness</string>
    <string name="action_auto_brightness_desc">Switches between automatic and manual brightness.</string>
    <string name="action_usb_debugging_title">USB debugging</string>
    <string name="action_usb_debugging_desc">Turns USB debugging on or off; otherwise opens Developer options.</string>
    <string name="action_wireless_debugging_title">Wireless debugging</string>
    <string name="action_wireless_debugging_desc">Turns wireless debugging on or off directly with \"Write secure settings\" or Shizuku (Wi-Fi must be connected); otherwise opens the Wireless debugging screen.</string>
    <string name="action_private_dns_title">Private DNS</string>
    <string name="action_private_dns_desc">Switches Private DNS between Off and Automatic; otherwise opens the DNS tool.</string>
    <string name="action_screen_lock_title">Lock screen</string>
