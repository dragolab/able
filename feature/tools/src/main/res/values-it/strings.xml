    <!-- Screen lock -->
    <string name="tools_lock_service_label">Servizio Accessibilità di Able</string>
    <string name="tools_lock_intro">Able blocca lo schermo tramite il suo servizio Accessibilità, il metodo che Android supporta per le app senza diritti di amministratore.</string>
    <string name="tools_lock_access_title">A cosa serve questo accesso</string>
    <string name="tools_lock_access_body">Il servizio serve solo a inviare l\'azione \"blocca schermo\" di Android quando la richiedi. Able non legge i contenuti dello schermo, il testo digitato o le notifiche.</string>
    <string name="tools_lock_access_privacy">Puoi disattivare il servizio in qualsiasi momento nelle impostazioni Accessibilità di Android.</string>
    <string name="tools_lock_open_accessibility">Apri impostazioni Accessibilità</string>
    <string name="tools_lock_manage_service">Gestisci nelle impostazioni Accessibilità</string>
    <string name="tools_lock_service_off_title">Servizio non attivo</string>
    <string name="tools_lock_service_off_message">Attiva \"Able\" nelle impostazioni Accessibilità di Android, poi torna qui per provarlo.</string>
    <string name="tools_lock_test_title">Prova</string>
    <string name="tools_lock_test_body">Blocca lo schermo ora per verificare che funzioni su questo dispositivo.</string>
    <string name="tools_lock_test_action">Blocca ora</string>
    <string name="tools_lock_test_failed">Android non ha bloccato lo schermo. Prova a disattivare e riattivare il servizio Accessibilità.</string>
    <string name="tools_lock_double_tap_title">Doppio tocco per bloccare</string>
    <string name="tools_lock_double_tap_body">Android non consente alle app di rilevare i tocchi sulla schermata Home o di blocco. Il doppio tocco funziona solo se il tuo launcher offre un gesto che avvia un\'azione di un\'app. Altrimenti usa le alternative qui sotto.</string>
    <string name="tools_lock_alternatives_title">Altri modi per bloccare</string>
    <string name="tools_lock_alternative_tile">Impostazioni rapide: aggiungi il riquadro \"Blocco schermo\" di Able per bloccare con un tocco dalla tendina delle notifiche.</string>
    <string name="tools_lock_alternative_shortcut">Schermata Home: una scorciatoia fissata che blocca direttamente non è ancora disponibile.</string>
    <string name="tools_lock_alternative_note">Il riquadro usa lo stesso servizio Accessibilità e indica quando serve la configurazione.</string>
    <string name="tools_lock_tile_label">Blocco schermo</string>
    <string name="tools_lock_tile_add">Aggiungi riquadro rapido</string>
    <string name="tools_lock_tile_added">Riquadro aggiunto alle Impostazioni rapide.</string>
    <string name="tools_lock_tile_already">Il riquadro è già nelle Impostazioni rapide.</string>
    <string name="tools_lock_tile_not_added">Il riquadro non è stato aggiunto.</string>
    <string name="tools_lock_tile_failed">Android non ha potuto aggiungere il riquadro. Modifica le Impostazioni rapide per aggiungerlo a mano.</string>

