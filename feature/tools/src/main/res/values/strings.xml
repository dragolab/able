    <!-- Screen lock (LOCK-001, LOCK-002) -->
    <string name="tools_lock_service_label">Able Accessibility service</string>
    <string name="tools_lock_intro">Able locks the screen through its Accessibility service, the method Android supports for apps without device admin rights.</string>
    <string name="tools_lock_access_title">What this access does</string>
    <string name="tools_lock_access_body">The service is used only to send Android\'s \"lock screen\" action when you ask for it. Able does not read screen content, typed text or notifications.</string>
    <string name="tools_lock_access_privacy">You can turn the service off at any time in Android Accessibility settings.</string>
    <string name="tools_lock_open_accessibility">Open Accessibility settings</string>
    <string name="tools_lock_manage_service">Manage in Accessibility settings</string>
    <string name="tools_lock_service_off_title">Service not enabled</string>
    <string name="tools_lock_service_off_message">Enable \"Able\" in Android Accessibility settings, then come back to test it.</string>
    <string name="tools_lock_test_title">Test</string>
    <string name="tools_lock_test_body">Lock the screen now to check that it works on this device.</string>
    <string name="tools_lock_test_action">Lock now</string>
    <string name="tools_lock_test_failed">Android did not lock the screen. Try turning the Accessibility service off and on again.</string>
    <string name="tools_lock_double_tap_title">Double tap to lock</string>
    <string name="tools_lock_double_tap_body">Android does not let apps detect taps on the home screen or lock screen. Double tap works only where your launcher offers a gesture that can start an app action. Otherwise, use the alternatives below.</string>
    <string name="tools_lock_alternatives_title">Other ways to lock</string>
    <string name="tools_lock_alternative_tile">Quick Settings: add the Able \"Screen lock\" tile to lock with one tap from the notification shade.</string>
    <string name="tools_lock_alternative_shortcut">Home screen: a pinned shortcut that locks directly is not available yet.</string>
    <string name="tools_lock_alternative_note">The tile uses the same Accessibility service and shows when setup is needed.</string>
    <string name="tools_lock_tile_label">Screen lock</string>
    <string name="tools_lock_tile_add">Add Quick Settings tile</string>
    <string name="tools_lock_tile_added">Tile added to Quick Settings.</string>
