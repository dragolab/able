    <!-- System-wide cache cleanup (STO-002) -->
    <string name="storage_system_cache_title">App caches</string>
    <string name="storage_system_cache_body">Asks Android to delete cached files of all apps. Apps rebuild them when needed, so they may open a bit slower once.</string>
    <string name="storage_trim_action">Clear all caches</string>
    <string name="storage_trim_help_title">Clear all caches</string>
    <string name="storage_trim_help_text">Able asks Android (through Shizuku) to free as much cache as it can for every app. Your files, accounts and settings are not touched. Android decides what to delete, so the result can be small or zero. Able measures free space before and after and shows only what was actually freed. Nothing needs to be undone: apps recreate their cache.</string>
    <string name="storage_trim_confirm_title">Clear all app caches?</string>
    <string name="storage_trim_confirm_message">Android deletes temporary files of all apps. Your data is kept. Apps may load a bit slower the first time.</string>
    <string name="storage_trim_done">Android freed %1$s of cache (measured).</string>
    <string name="storage_freed_none">0 bytes freed. Android had nothing more to clear.</string>
    <string name="storage_trim_unmeasured">Android accepted the request, but free space could not be measured.</string>
    <string name="storage_trim_failed">Android rejected the cache cleanup.</string>
    <string name="storage_apps_select_hint">Select apps to clear only their cache.</string>
    <string name="storage_apps_help_title">Clear an app\'s cache</string>
    <string name="storage_apps_help_text">Deletes only the selected apps\' temporary files, like Android\'s own \"Clear cache\" button in App info. Data, logins and settings stay. Able re-reads each app\'s cache afterwards and reports the measured difference.</string>
    <string name="storage_apps_confirm_title">Clear cache of selected apps (%1$d)?</string>
    <string name="storage_apps_confirm_message">About %1$s of cache. Data, logins and settings are kept.</string>
    <string name="storage_apps_done">Apps cleared: %1$d. Freed %2$s (measured).</string>
    <string name="storage_apps_done_none">Apps cleared: %1$d. 0 bytes freed (measured).</string>
    <string name="storage_apps_partial">Apps cleared: %1$d of %2$d. Freed %3$s. Android rejected the others.</string>
    <string name="storage_apps_failed">Android rejected clearing these caches.</string>
    <string name="storage_select_app">Select %1$s</string>
    <string name="storage_shizuku_needed_title">System-wide cleanup needs Shizuku</string>
    <string name="storage_shizuku_needed_message">Android lets only system tools clear other apps\' caches. With Shizuku, Able can ask Android to do it. Without it, use Android\'s storage settings or each app\'s App info.</string>
    <string name="storage_shizuku_help_title">Why Shizuku?</string>
    <string name="storage_shizuku_help_text">Regular apps cannot delete other apps\' caches. Shizuku runs Android\'s own package manager commands with shell rights, after you start it and allow Able. Without Shizuku, open Android storage settings or an app\'s App info and tap \"Clear cache\".</string>
    <string name="storage_shizuku_allow">Allow Shizuku</string>
    <string name="storage_open_storage_settings">Open Android storage settings</string>
    <string name="storage_able_cache_body">Clears only temporary files created by Able. Works without Shizuku.</string>

    <!-- Review files (STO-001) -->
    <string name="storage_delete_help_title">Delete files</string>
    <string name="storage_delete_help_text">Select files to review them. For media, Android shows its own confirmation before anything is deleted; for a folder, Able asks first. Deleted files cannot be recovered. Able checks afterwards which files are really gone.</string>

