    <string name="battery_level_osserva_desc">Only shows information. Nothing changes.</string>
    <string name="battery_level_limita">Limita in background</string>
    <string name="battery_level_limita_desc">Supported Android restriction while the profile is active. Sync and notifications may be delayed.</string>
    <string name="battery_level_arresta">Arresta quando esco</string>
    <string name="battery_level_arresta_desc">Force-stops the app after you leave it (requires Shizuku). Notifications and alarms may stop until you open it again.</string>

